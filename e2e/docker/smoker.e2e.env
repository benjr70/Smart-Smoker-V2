# Build-time env baked into the smoker web bundle for the hermetic e2e stack.
# The smoker app reads REACT_APP_CLOUD_URL* at build time (dotenv-webpack); the
# e2e compose publishes the backend on the host at :3001, so these localhost
# values let the browser-driven smoker page reach it. REACT_APP_DEVICE_URL is
# deliberately absent: the app then keeps its loopback :3003 default, which is
# exactly where this stack publishes device-service. A per-PR stack overrides all
# three via the stack.Dockerfile SMOKER_* build args.
#
# ENV is intentionally NOT "production" so the smoker skips the device
# connection-status polling that only matters on a real Raspberry Pi.
ENV=e2e
REACT_APP_CLOUD_URL=http://localhost:3001
REACT_APP_CLOUD_URL_API=http://localhost:3001/api/
