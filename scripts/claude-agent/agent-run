#!/usr/bin/env bash
# agent-run — VM wrapper that fires `/afk-pickup` autonomously, no human prompts.
#
# One fire = one issue picked, implemented, PR opened, CI watched to verdict.
# Designed to run on the claude-agent-1 Proxmox VM (see docs/CI-CD/claude-agent-vm.md).
# Cron / scheduler (or agent-daemon) invokes this; output goes to a timestamped
# log under ~/claude-agent/logs/ AND stdout so cron mailers can capture summaries.
#
# After the fire, the Exhaustion Classifier inspects the captured output + exit
# code. If the run was cut off by Claude usage exhaustion, agent-run PAUSES the
# in-flight issue instead of failing: it freezes partial work with a `wip:`
# commit, flips the issue `AFK:in-progress -> AFK:paused` (leaving the branch
# intact), records the pause as a timestamped comment, emits any scraped reset
# instant for the daemon, and exits 0 — an out-of-gas event is never a failure.
#
# A RESOLVE fire (`/afk-resolve` on a wayfinder Decision ticket, marked by the
# `resolve: #<n> <type> <slug>` line the skill emits) is the exception: there is
# no partial implementation worth resuming, only half-read research. Exhausting
# one drops the `AFK:in-progress` lock, deletes any pushed `research/<slug>`
# branch and applies NO label, so the next tick simply restarts the resolve from
# scratch. Once the resolve has printed a terminal line the skill owns the
# ticket's end state and a later crash or cutoff only tidies the lock: `DONE …
# closed` leaves AFK:done, `DONE … relabelled HITL` leaves the HITL ticket
# entirely alone, and `FAILED` keeps the skill's own AFK:failed and its comment.
#
# Usage:
#   agent-run                     # fire once, exit per the classification below
#   agent-run --dry-run           # forward --dry-run to /afk-pickup
#
# Exit codes:
#   0   — /afk-pickup completed cleanly, OR the run was paused (EXHAUSTED):
#         partial work is frozen and the issue is left in AFK:paused for resume.
#   non-0 — /afk-pickup genuinely failed (§6b path); cron mailer should escalate.
#
# Injectable for tests (default to the real binaries):
#   CLAUDE_BIN  claude CLI          GH_BIN  gh CLI          GIT_BIN  git

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# shellcheck source=lib/exhaustion-classifier.sh
. "${SCRIPT_DIR}/lib/exhaustion-classifier.sh"

REPO_DIR="${REPO_DIR:-$HOME/Smart-Smoker-V2}"
LOG_DIR="${LOG_DIR:-$HOME/claude-agent/logs}"
CLAUDE_BIN="${CLAUDE_BIN:-claude}"
GH_BIN="${GH_BIN:-gh}"
GIT_BIN="${GIT_BIN:-git}"
TS="$(date -u +%Y%m%dT%H%M%SZ)"
LOG_FILE="$LOG_DIR/afk-pickup-$TS.log"

mkdir -p "$LOG_DIR"

if [ ! -d "$REPO_DIR/.git" ]; then
  echo "agent-run: ERROR — $REPO_DIR is not a git checkout" >&2
  exit 2
fi

if ! command -v "$CLAUDE_BIN" >/dev/null 2>&1; then
  echo "agent-run: ERROR — claude CLI ($CLAUDE_BIN) not on PATH" >&2
  exit 2
fi

cd "$REPO_DIR"

# Refresh master so /afk-pickup §4 branches from up-to-date origin/master.
"$GIT_BIN" fetch --quiet origin master || {
  echo "agent-run: WARN — git fetch failed, continuing with cached refs" | tee -a "$LOG_FILE"
}

# Every fire starts from the tip of master: a prior run may have left the
# checkout on its feat/issue-N branch or with crash debris in the tree.
# Anything worth keeping is already committed on its own branch (an exhausted
# run freezes partial work with a wip commit before pausing), so discarding
# local state here loses nothing.
"$GIT_BIN" reset --hard --quiet || true
"$GIT_BIN" checkout --quiet master || {
  echo "agent-run: ERROR — cannot checkout master in $REPO_DIR" >&2
  exit 2
}
"$GIT_BIN" reset --hard --quiet origin/master || {
  echo "agent-run: WARN — reset to origin/master failed, continuing on local master" | tee -a "$LOG_FILE"
}

DRY_RUN_FLAG=""
if [ "${1:-}" = "--dry-run" ]; then
  DRY_RUN_FLAG=" --dry-run"
fi

echo "=== agent-run $TS ===" | tee -a "$LOG_FILE"
echo "repo:   $REPO_DIR"      | tee -a "$LOG_FILE"
echo "log:    $LOG_FILE"      | tee -a "$LOG_FILE"
echo "prompt: /afk-pickup$DRY_RUN_FLAG" | tee -a "$LOG_FILE"
echo                          | tee -a "$LOG_FILE"

# `/afk-pickup` spawns background subagents (implementer/reviewer/verifier) that
# routinely run well past `claude --print`'s default 600s background-task ceiling.
# Left at the default, print terminates the team mid-dispatch and returns exit 0
# with no PR and the issue still locked. 0 = wait indefinitely. Honor a host
# override (e.g. the systemd EnvironmentFile drop-in) if one is already set.
export CLAUDE_CODE_PRINT_BG_WAIT_CEILING_MS="${CLAUDE_CODE_PRINT_BG_WAIT_CEILING_MS:-0}"

# AGENT_RUN_MODEL (set by the daemon when the preferred model's weekly is
# spent, e.g. Fable at 100%) pins the whole run — the lead session and every
# subagent that inherits its model — to the fallback model. Empty/unset means
# the session default.
MODEL_ARGS=()
if [ -n "${AGENT_RUN_MODEL:-}" ]; then
  MODEL_ARGS=(--model "${AGENT_RUN_MODEL}")
  echo "model:  ${AGENT_RUN_MODEL} (AGENT_RUN_MODEL fallback)" | tee -a "$LOG_FILE"
fi

set +e
"$CLAUDE_BIN" \
  --permission-mode bypassPermissions \
  --print \
  "${MODEL_ARGS[@]}" \
  "/afk-pickup$DRY_RUN_FLAG" \
  2>&1 | tee -a "$LOG_FILE"
EXIT_CODE=${PIPESTATUS[0]}
set -e

echo                                       | tee -a "$LOG_FILE"
echo "=== agent-run exit $EXIT_CODE ===" | tee -a "$LOG_FILE"

# Classify the run from its captured output + exit code: OK / EXHAUSTED / FAILED.
VERDICT="$(exhaustion_classify "$EXIT_CODE" < "$LOG_FILE")"
STATUS="$(printf '%s' "$VERDICT" | jq -r '.status')"
RESET_AT="$(printf '%s' "$VERDICT" | jq -r '.resetAt')"

# resolve_fire — echo the `resolve: #<n> <type> <slug>` line this run emitted, if
# any. `/afk-resolve` prints it as its first act after claiming the ticket, the
# same way §1.2 prints `picked:   reconcile PR …`; its presence is what tells the
# cleanup paths below they are looking at a resolve rather than a slice.
resolve_fire() {
  grep -oE 'resolve:[[:space:]]+#[0-9]+[[:space:]]+(research|task)[[:space:]]+[A-Za-z0-9._-]+' \
    "$LOG_FILE" | head -1 || true
}

# resolve_done — true when the resolve printed its terminal `resolve: DONE …`
# line before dying. Everything after that line (map append, fog graduation,
# token accounting) runs on a ticket that is already closed and answered, so a
# crash or an out-of-gas exit there owes only the lock, never a label flip and
# never the branch.
resolve_done() {
  grep -qE 'resolve:[[:space:]]+DONE' "$LOG_FILE"
}

# resolve_hitl — true when the resolve's terminal line was the `relabelled HITL`
# outcome: a Decision ticket that turned out to need product code. The skill has
# already stripped the whole AFK family (AFK, AFK:in-progress) and added HITL, so
# the ticket is a human's now. Re-adding AFK:done here would put the ticket back
# in the AFK family the skill deliberately removed it from, so this case owes
# nothing at all — not even the lock, which is already gone.
resolve_hitl() {
  grep -qE 'resolve:[[:space:]]+DONE.*relabelled HITL' "$LOG_FILE"
}

# resolve_failed — true when the resolve printed its own terminal
# `resolve: FAILED — #<n> <reason>` line. The skill has already applied
# AFK:failed AND posted the explaining comment naming the real reason, so a
# second "crashed / exited non-zero" comment from here would contradict it.
resolve_failed() {
  grep -qE 'resolve:[[:space:]]+FAILED' "$LOG_FILE"
}

# resolve_settled — true once ANY terminal resolve line went out (DONE, HITL or
# FAILED). Past it there is no half-finished resolve to undo: the ticket carries
# its settled labels and the `research/<slug>` branch is either the merged PR's
# head or the head of a PR left open on purpose for the docs-merge reconcile.
# Either way, deleting it would be destructive.
resolve_settled() {
  resolve_done || resolve_failed
}

# resolve_cleanup — the out-of-gas exit for a resolve fire. Research is cheap to
# redo and expensive to half-keep: a frozen branch of partial notes would be
# restarted-from anyway, and a label would take the ticket out of the queue it
# must stay in. So: drop the lock, delete the pushed branch, apply NO label —
# the state a fresh tick expects. Best-effort throughout (|| true).
resolve_cleanup() {
  local line="$1" issue slug
  issue="$(printf '%s' "$line" | grep -oE '#[0-9]+' | grep -oE '[0-9]+')"
  slug="$(printf '%s' "$line" | awk '{print $NF}')"

  "$GH_BIN" issue edit "$issue" --remove-label AFK:in-progress || true

  # Past a terminal resolve line there is no half-finished resolve to undo: on
  # DONE the findings are merged and the ticket is closed, and on FAILED the
  # gate-refused path deliberately leaves the research PR open for the next
  # fire's docs-merge reconcile. Deleting research/<slug> in either case would
  # destroy a branch something else still needs.
  if resolve_settled; then
    echo "agent-run: resolve #${issue} settled before running out of gas — lock dropped only" \
      | tee -a "$LOG_FILE"
    return 0
  fi

  "$GIT_BIN" push origin --delete "research/${slug}" || true

  echo "agent-run: resolve #${issue} out of gas — lock dropped, research/${slug} deleted, no label" \
    | tee -a "$LOG_FILE"
}

# pause_inflight — freeze partial work and move the in-flight issue to
# AFK:paused. Every step is best-effort (|| true): a pause must never itself
# fail the run and re-wedge the pipeline. AFK:failed is never applied here.
pause_inflight() {
  local reset_at="$1" issue ts note

  issue="$("$GH_BIN" issue list --label AFK:in-progress --state open \
    --json number --jq '.[0].number' 2>/dev/null || true)"
  if [ -z "$issue" ] || [ "$issue" = "null" ]; then
    echo "agent-run: EXHAUSTED but no AFK:in-progress issue to pause" | tee -a "$LOG_FILE"
    return 0
  fi

  # Freeze any partial edits so the next checkout does not lose uncommitted work.
  "$GIT_BIN" add -A || true
  if ! "$GIT_BIN" diff --cached --quiet 2>/dev/null; then
    "$GIT_BIN" commit -m "wip: freeze partial work on #${issue} (usage exhausted)" || true
  fi

  # Flip the lock to paused, keeping the branch intact for resume next window.
  "$GH_BIN" issue edit "$issue" \
    --remove-label AFK:in-progress --add-label AFK:paused || true

  ts="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  note="Run paused at ${ts} — Claude usage exhausted mid-run. Branch kept for resume."
  if [ -n "$reset_at" ]; then
    note="${note} Budget resets at ${reset_at}."
  fi
  "$GH_BIN" issue comment "$issue" --body "$note" || true

  echo "agent-run: paused #${issue} (AFK:in-progress -> AFK:paused)" | tee -a "$LOG_FILE"
}

# fail_inflight — on a genuine failure, clear the lock THIS run created so the
# next fire is not blocked forever. Scoped to the issue this run picked (scraped
# from the `picked:   #N` line in this run's own log): if claude crashed before
# afk-pickup's §6b could clean up, the AFK:in-progress lock leaks and every
# future fire skips (observed 2026-07-08: #280 stuck for a day). Never touches a
# lock this run did not create. Idempotent with §6b (best-effort, || true).
#
# A resolve fire (`resolve: #N <type> <slug>`) fails like an issue: its ticket is
# still open and unanswered, so it takes AFK:failed plus an explaining comment —
# unless a terminal resolve line already went out, in which case the skill owns
# the end state: `DONE … closed` restores AFK:done only, `DONE … relabelled HITL`
# restores nothing (the AFK family was removed on purpose), and `FAILED` re-asserts
# AFK:failed without a second, contradictory comment.
#
# A reconcile fire (`picked:   reconcile PR #P (issue #N)`) is special: the
# issue's work was already DONE — the fire only borrowed AFK:in-progress as
# the single-flight lock while nursing the PR. On a crash the lock is restored
# to AFK:done, never AFK:failed (failing a finished issue would lie), and the
# breadcrumb lands on the PR where the human is looking.
fail_inflight() {
  local issue ts pr resolve
  resolve="$(resolve_fire)"
  if [ -n "$resolve" ]; then
    issue="$(printf '%s' "$resolve" | grep -oE '#[0-9]+' | grep -oE '[0-9]+')"

    # Crashed AFTER the terminal DONE line: the ticket is closed with its answer
    # recorded, and the tail that died (map append, fog graduation, token
    # accounting) is best-effort by design. Failing it here would label a
    # resolved ticket AFK:failed and tell a human it is still open — a lie, the
    # same one the reconcile path below exists to avoid. Restore AFK:done and
    # say nothing on the ticket.
    #
    # The `relabelled HITL` outcome is a DONE too, but its end state is the
    # opposite: the skill stripped `AFK` AND `AFK:in-progress` and handed the
    # ticket to a human. Restoring AFK:done there would re-add an AFK-family
    # label to a ticket deliberately routed out of the queue, so this branch
    # comes first and touches nothing.
    if resolve_hitl; then
      echo "agent-run: resolve #${issue} relabelled HITL before the crash — no AFK label restored" \
        | tee -a "$LOG_FILE"
      return 0
    fi

    if resolve_done; then
      "$GH_BIN" issue edit "$issue" \
        --remove-label AFK:in-progress --add-label AFK:done || true
      echo "agent-run: resolve #${issue} crashed after DONE — left AFK:done, no failure" \
        | tee -a "$LOG_FILE"
      return 0
    fi

    # The skill already failed the ticket itself (§7): AFK:failed is on and a
    # comment names the real reason. Re-assert the label idempotently in case
    # the crash landed between the two calls, but post NO second comment — two
    # conflicting causes on one ticket is worse than none.
    if resolve_failed; then
      "$GH_BIN" issue edit "$issue" \
        --remove-label AFK:in-progress --add-label AFK:failed || true
      echo "agent-run: resolve #${issue} already reported its own failure — no second comment" \
        | tee -a "$LOG_FILE"
      return 0
    fi

    "$GH_BIN" issue edit "$issue" \
      --remove-label AFK:in-progress --add-label AFK:failed || true
    ts="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    "$GH_BIN" issue comment "$issue" \
      --body "Resolve fire crashed at ${ts} — /afk-resolve exited non-zero. Lock cleared (AFK:in-progress → AFK:failed); the ticket stays open for human triage." || true
    echo "agent-run: failed resolve — #${issue} (AFK:in-progress -> AFK:failed)" | tee -a "$LOG_FILE"
    return 0
  fi

  pr="$(grep -oE 'picked:[[:space:]]+reconcile PR #[0-9]+ \(issue #[0-9]+\)' "$LOG_FILE" | head -1 || true)"
  if [ -n "$pr" ]; then
    issue="$(printf '%s' "$pr" | grep -oE 'issue #[0-9]+' | grep -oE '[0-9]+' || true)"
    "$GH_BIN" issue edit "$issue" \
      --remove-label AFK:in-progress --add-label AFK:done || true
    ts="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    "$GH_BIN" pr comment "$(printf '%s' "$pr" | grep -oE 'PR #[0-9]+' | grep -oE '[0-9]+')" \
      --body "Reconcile fire crashed at ${ts} — lock restored (AFK:in-progress → AFK:done on issue #${issue}). PR left as-is for the next fire or human triage." || true
    echo "agent-run: failed reconcile — restored #${issue} (AFK:in-progress -> AFK:done)" | tee -a "$LOG_FILE"
    return 0
  fi

  issue="$(grep -oE 'picked:[[:space:]]+#[0-9]+' "$LOG_FILE" | grep -oE '[0-9]+' | head -1 || true)"
  if [ -z "$issue" ]; then
    echo "agent-run: FAILED with no issue picked — no lock to clear" | tee -a "$LOG_FILE"
    return 0
  fi

  "$GH_BIN" issue edit "$issue" \
    --remove-label AFK:in-progress --add-label AFK:failed || true

  ts="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  "$GH_BIN" issue comment "$issue" \
    --body "Run failed at ${ts} — afk-pickup fire exited non-zero. Lock cleared (AFK:in-progress → AFK:failed) for human triage." || true

  echo "agent-run: failed #${issue} (AFK:in-progress -> AFK:failed)" | tee -a "$LOG_FILE"
}

case "$STATUS" in
  EXHAUSTED)
    RESOLVE_LINE="$(resolve_fire)"
    if [ -n "$RESOLVE_LINE" ]; then
      echo "agent-run: EXHAUSTED mid-resolve — dropping the lock; resetAt=${RESET_AT}" | tee -a "$LOG_FILE"
      resolve_cleanup "$RESOLVE_LINE"
    else
      echo "agent-run: EXHAUSTED — pausing in-flight work; resetAt=${RESET_AT}" | tee -a "$LOG_FILE"
      pause_inflight "$RESET_AT"
    fi
    # Emit the scraped reset instant on a stable line for the daemon to schedule off.
    echo "AGENT_RUN_RESET_AT=${RESET_AT}" | tee -a "$LOG_FILE"
    exit 0
    ;;
  FAILED)
    echo "agent-run: FAILED — exit $EXIT_CODE" | tee -a "$LOG_FILE"
    fail_inflight
    exit "$EXIT_CODE"
    ;;
  *)
    # Clean run that picked nothing (empty queue or a stale in-flight skip):
    # tell the daemon so it sleeps out the window instead of re-firing into an
    # empty pick loop. Match both the stable machine lines the skill emits
    # (`afk-pickup: skip` / `afk-pickup: no eligible issue`) and the human
    # report line (`picked:   skip — N in flight`) observed live 2026-07-09 —
    # missing the latter made the daemon treat a skip as a clean run and
    # hot-loop into the lock.
    if grep -qE 'afk-pickup: (no eligible issue|skip)|^[[:space:]]*picked:[[:space:]]+(skip|no eligible)' "$LOG_FILE"; then
      echo "AGENT_RUN_NO_WORK=1" | tee -a "$LOG_FILE"
    fi
    exit "$EXIT_CODE"
    ;;
esac
