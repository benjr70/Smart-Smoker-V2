# Backend environment template — copy to `.env` for local development.
#
# Every value here is intentionally BLANK. Real values live in GitHub
# repository secrets and are injected by the deploy workflows
# (.github/workflows/dev-deploy.yml, .github/workflows/prod-deploy.yml), which
# export them into the shell environment that the cloud compose files read.
# Never commit a filled-in copy of this file.

# MongoDB connection string the backend connects to at boot.
# Format: mongodb://<user>:<password>@<host>:27017/<db>?authSource=admin
DB_URL=

# Web-push VAPID public key. Handed to browsers so they can subscribe.
# Generate a pair with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=

# Web-push VAPID private key. Secret — signs push messages. Never commit it.
VAPID_PRIVATE_KEY=

# Comma-separated extra browser origins appended to the built-in CORS
# allow-list. Used by hermetic per-PR stacks; empty in normal deployments.
CORS_EXTRA_ORIGINS=

# Runtime mode. `local` enables pretty-printed logs; anything else logs JSON.
NODE_ENV=

# Pino log level (trace|debug|info|warn|error|fatal). Defaults to `info`.
LOG_LEVEL=
