# The dependency tree only resolves with peer edges ignored: apps/backend pins
# @nestjs/core ^8 alongside @nestjs/websockets 9, an ERESOLVE conflict on any
# from-scratch install. Committed here rather than carried as a --legacy-peer-deps
# flag on each call site so that tooling which runs npm on its own -- Dependabot
# regenerating package-lock.json, or a contributor running plain `npm ci` --
# produces the same tree shape the repo already has. npm reads a project .npmrc,
# and Dependabot copies this file into its working checkout.
legacy-peer-deps=true
