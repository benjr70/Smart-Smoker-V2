# The dependency tree only resolves with peer edges ignored: apps/backend pins
# @nestjs/core ^8 alongside @nestjs/websockets 9, an ERESOLVE conflict on any
# from-scratch install. Committing the policy here makes it apply to npm runs
# whose cwd is the repo root -- `npm run bootstrap`, `npm ci`, and Dependabot
# regenerating package-lock.json in its own checkout -- so tooling that invokes
# npm on its own produces the same tree shape the repo already has.
#
# Its reach stops at the repo root: npm only reads a project .npmrc from the
# current working directory, so installs run from apps/* (`cd apps/frontend &&
# npm install`) and Docker builds that COPY only the manifests and the lockfile
# still need an explicit --legacy-peer-deps. Keep those flags where they are;
# CONTRIBUTING.md, CLAUDE.md, AGENTS.md and the build instructions describe the
# same rule.
legacy-peer-deps=true
